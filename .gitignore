# secrets (.env.vercel holds the cloud DATABASE_URL — scripts/deploy_vercel.sh pull-env)
.env
.env.*
!.env.example
*.key

# the assembled Vercel bundle (scripts/build_vercel.sh) and its project link
build/

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ml artifacts (commit run CSVs, not large binaries)
ml/models/*.json
ml/models/*.pkl
ml/models/*.ubj
!ml/models/.gitkeep

# data (keep reference small + committed; ignore bulky raw)
data/raw/*
!data/raw/.gitkeep
# Gemini caches (dev runs); demo pre-cache is curated separately
data/processed/listing_cache/
data/processed/maker_story_cache/

# backend runtime state — NOT source. The dev SQLite DB is recreated by
# init_db() on startup, and data/uploads/ is artisan-uploaded photos/audio
# (real phone numbers, real voice notes, real photos during testing). This
# repo is public; none of that belongs in it.
backend/data/

# local test recordings
*.m4a

# generated assets
assets/generated/*
!assets/generated/.gitkeep

# flutter
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins*

# os / editor
.DS_Store
.idea/
.vscode/

# smoke / run outputs
results/
